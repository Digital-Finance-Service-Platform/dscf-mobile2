{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  },
  "updates": {
    "enabled": true,
    "codeSigningCertificate": "./certs/code-signing-cert.pem",
    "codeSigningMetadata": "./certs/code-signing-metadata.json",
    "channel": "production",
    "distribution": "generic"
  }
}
