# Example environment variables for dscf-mobile2
# Set the API base URL (used to construct marketplace endpoints)
NEXT_PUBLIC_API_BASE_URL=https://uat.api.fcgm.pro.et
# Optional Expo variants (Expo picks up EXPO_PUBLIC_* or values from app.config.js)
EXPO_PUBLIC_API_BASE_URL=https://uat.api.fcgm.pro.et
# If you want to override only the marketplace path explicitly:
NEXT_PUBLIC_MARKET_URL=https://uat.api.fcgm.pro.et/marketplace
EXPO_PUBLIC_MARKET_URL=https://uat.api.fcgm.pro.et/marketplace
